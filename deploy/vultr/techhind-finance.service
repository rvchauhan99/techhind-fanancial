[Unit]
Description=TechHind Company Finance API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/techhind-finance/backend
EnvironmentFile=/opt/techhind-finance/backend/.env
# Host Caddy on this VPS terminates TLS and proxies to localhost.
# Jweller uses public port 80, so Caddy listens on 443 only.
ExecStart=/opt/techhind-finance/venv/bin/uvicorn server:app --host 127.0.0.1 --port 8010 --workers 2
Restart=always
RestartSec=5
Environment=PATH=/opt/techhind-finance/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
